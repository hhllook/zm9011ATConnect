<UserControl x:Class="Zm9011.Modules.ModuleName.Views.ZteExtView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1180" HorizontalAlignment="Stretch">

            <GroupBox Header="注册运营商信息 +ZDON" Style="{StaticResource AtGroupBox}">
                <WrapPanel>
                    <Button Content="查询运营商信息" Command="{Binding QueryZdonCommand}" Style="{StaticResource AtButton}"
                            ToolTip="命令 +ZDON? · 查询已注册的运营商信息（手册 7.1）"/>
                </WrapPanel>
            </GroupBox>

            <GroupBox Header="PIN/PUK 剩余次数 +ZPINC" Style="{StaticResource AtGroupBox}">
                <WrapPanel>
                    <Button Content="查询全部次数" Command="{Binding QueryZpincCommand}" Style="{StaticResource AtButton}"
                            ToolTip="命令 +ZPINC? · 查询全部 PIN/PUK 剩余次数（手册 7.2）"/>
                    <TextBlock Text="facility:" Style="{StaticResource AtFieldLabel}" Margin="14,0,6,0"/>
                    <ComboBox ItemsSource="{Binding ZpincFacilities}" SelectedItem="{Binding ZpincFacility}"
                              Style="{StaticResource AtCombo}" Width="90"/>
                    <Button Content="查询单项次数" Command="{Binding QueryZpincFacilityCommand}" Style="{StaticResource AtButton}"
                            ToolTip="命令 +ZPINC= · 查询指定 facility 的 PIN/PUK 剩余次数（手册 7.2）"/>
                </WrapPanel>
            </GroupBox>

            <GroupBox Header="SIM 卡信息" Style="{StaticResource AtGroupBox}">
                <WrapPanel>
                    <Button Content="查询 ICCID" Command="{Binding QueryCcidCommand}" Style="{StaticResource AtButton}"
                            ToolTip="命令 +CCID · 查询 SIM 卡 ICCID（手册 7.3）"/>
                    <Button Content="查询初始化状态" Command="{Binding QueryZinistatCommand}" Style="{StaticResource AtButton}"
                            ToolTip="命令 +ZINISTAT · 查询 SIM 卡初始化状态（手册 7.4）"/>
                </WrapPanel>
            </GroupBox>

            <GroupBox Header="SIM 卡热插拔检测 +SPCARDINFO（须不插卡时设置，重启生效）" Style="{StaticResource AtGroupBox}">
                <StackPanel>
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock Text="P1:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                            <ComboBox Style="{StaticResource AtCombo}" Width="120" SelectedValue="{Binding SpCardP1}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="0 设置" Tag="0"/>
                                <ComboBoxItem Content="1 查询" Tag="1"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="P2:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                            <ComboBox Style="{StaticResource AtCombo}" Width="155" SelectedValue="{Binding SpCardP2}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="1 开热插拔" Tag="1"/>
                                <ComboBoxItem Content="0 关热插拔" Tag="0"/>
                                <ComboBoxItem Content="3 双卡低电平" Tag="3"/>
                                <ComboBoxItem Content="771 双卡高电平" Tag="771"/>
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="设置热插拔" Command="{Binding SetSpCardInfoCommand}" Style="{StaticResource AtButton}"
                                ToolTip="命令 +SPCARDINFO= · 设置 SIM 卡热插拔检测（手册 7.5）"/>
                        <Button Content="查询热插拔" Command="{Binding QuerySpCardInfoCommand}" Style="{StaticResource AtButton}"
                                ToolTip="命令 +SPCARDINFO=5,1,0 · 查询 SIM 卡热插拔检测状态（手册 7.5）"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="双卡切换 +ZSWSLOT" Style="{StaticResource AtGroupBox}">
                <WrapPanel>
                    <TextBlock Text="卡槽:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                    <ComboBox Style="{StaticResource AtCombo}" Width="110" SelectedValue="{Binding SwSlot}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="1 卡槽1" Tag="1"/>
                        <ComboBoxItem Content="2 卡槽2" Tag="2"/>
                    </ComboBox>
                    <Button Content="切换卡槽" Command="{Binding SetSwSlotCommand}" Style="{StaticResource AtButton}"
                            ToolTip="命令 +ZSWSLOT= · 切换 SIM 卡槽（手册 7.6）"/>
                    <Button Content="查询卡槽" Command="{Binding QuerySwSlotCommand}" Style="{StaticResource AtButton}"
                            ToolTip="命令 +ZSWSLOT? · 查询当前 SIM 卡槽（手册 7.6）"/>
                </WrapPanel>
            </GroupBox>

            <GroupBox Header="ADB 调试端口 +ADBPSWD（密钥由中兴按 IMEI 提供）" Style="{StaticResource AtGroupBox}">
                <WrapPanel>
                    <TextBox Text="{Binding AdbPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AtInput}" Width="420"
                             ToolTip="填写中兴按 IMEI 提供的 ADB 密钥"/>
                    <Button Content="开启 ADB" Command="{Binding OpenAdbCommand}" Style="{StaticResource AtButton}"
                            ToolTip="命令 +ADBPSWD= · 在用户模式下切出 ADB 调试端口（手册 7.7）"/>
                </WrapPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
