<UserControl x:Class="Zm9011.Modules.ModuleName.Views.SmsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1180" HorizontalAlignment="Stretch">

            <GroupBox Header="短信模式 +CMGF" Style="{StaticResource AtGroupBox}">
                <WrapPanel>
                    <ComboBox Style="{StaticResource AtCombo}" Width="120" SelectedValue="{Binding SmsMode}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="1 TEXT 模式" Tag="1"/>
                        <ComboBoxItem Content="0 PDU 模式" Tag="0"/>
                    </ComboBox>
                    <Button Content="设置短信模式" Command="{Binding SetModeCommand}" Style="{StaticResource AtButton}"
                            ToolTip="命令 +CMGF= · 设置短信模式：1 TEXT / 0 PDU（手册 5.1）"/>
                    <Button Content="查询短信模式" Command="{Binding QueryModeCommand}" Style="{StaticResource AtButton}"
                            ToolTip="命令 +CMGF? · 查询当前短信模式（手册 5.1）"/>
                </WrapPanel>
            </GroupBox>

            <GroupBox Header="发送 / 存储 / 发送存储短信" Style="{StaticResource AtGroupBox}">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="目标号码:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                        <TextBox Text="{Binding DestAddress}" Style="{StaticResource AtInput}" Width="160"/>
                        <CheckBox Content="中文UCS2编码" IsChecked="{Binding UseUcs2}" VerticalAlignment="Center" Margin="10,0,0,0"
                                  ToolTip="勾选后先执行 +CSMP=17,255,0,8，正文按 UCS2 HEX 发送"/>
                    </WrapPanel>
                    <TextBox Text="{Binding SmsText, UpdateSourceTrigger=PropertyChanged}" Margin="4"
                             AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             ToolTip="TEXT 模式短信正文 / 交互式命令的输入正文"/>
                    <WrapPanel>
                        <Button Content="发送短信" Command="{Binding SendSmsCommand}" Style="{StaticResource AtButton}" FontWeight="SemiBold"
                                ToolTip="命令 +CMGS · 发送短信（手册 5.2）"/>
                        <Button Content="存储短信" Command="{Binding StoreSmsCommand}" Style="{StaticResource AtButton}"
                                ToolTip="命令 +CMGW · 存储短信到模组（手册 5.9）"/>
                        <TextBlock Text="索引:" Style="{StaticResource AtFieldLabel}" Margin="14,0,6,0"/>
                        <TextBox Text="{Binding StoredIndex}" Style="{StaticResource AtInput}" Width="60"/>
                        <Button Content="发送存储短信" Command="{Binding SendStoredCommand}" Style="{StaticResource AtButton}"
                                ToolTip="命令 +CMSS= · 发送存储区中的短信（手册 5.13）"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock Text="PDU 串:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                        <TextBox Text="{Binding PduText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AtInput}" Width="440"
                                 FontFamily="Consolas"/>
                        <TextBlock Text="长度:" Style="{StaticResource AtFieldLabel}" Margin="14,0,6,0"/>
                        <TextBox Text="{Binding PduLength}" Style="{StaticResource AtInput}" Width="60"/>
                        <TextBlock Text="(PDU 模式下按长度发送)" Foreground="#9CA1AA" VerticalAlignment="Center"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="短信中心 +CSCA / 存储选择 +CPMS" Style="{StaticResource AtGroupBox}">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="短信中心号码:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                        <TextBox Text="{Binding Sca}" Style="{StaticResource AtInput}" Width="180"/>
                        <Button Content="设置短信中心" Command="{Binding SetCscaCommand}" Style="{StaticResource AtButton}"
                                ToolTip="命令 +CSCA= · 设置短信中心号码（手册 5.4）"/>
                        <Button Content="查询短信中心" Command="{Binding QueryCscaCommand}" Style="{StaticResource AtButton}"
                                ToolTip="命令 +CSCA? · 查询短信中心号码（手册 5.4）"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <TextBlock Text="读取删除介质:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                            <ComboBox ItemsSource="{Binding MemOptions}" SelectedItem="{Binding Mem1}" Style="{StaticResource AtCombo}" Width="80"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <TextBlock Text="写入发送介质:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                            <ComboBox ItemsSource="{Binding MemOptions}" SelectedItem="{Binding Mem2}" Style="{StaticResource AtCombo}" Width="80"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="接收介质:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                            <ComboBox ItemsSource="{Binding MemOptions}" SelectedItem="{Binding Mem3}" Style="{StaticResource AtCombo}" Width="80"/>
                        </StackPanel>
                    </WrapPanel>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="设置存储介质" Command="{Binding SetCpmsCommand}" Style="{StaticResource AtButton}"
                                ToolTip="命令 +CPMS= · 设置短信存储介质（手册 5.5）"/>
                        <Button Content="查询存储介质" Command="{Binding QueryCpmsCommand}" Style="{StaticResource AtButton}"
                                ToolTip="命令 +CPMS? · 查询短信存储介质与容量（手册 5.5）"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="读取 / 列表 / 删除" Style="{StaticResource AtGroupBox}">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="索引:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                        <TextBox Text="{Binding ReadIndex}" Style="{StaticResource AtInput}" Width="60"/>
                        <Button Content="读取短信" Command="{Binding ReadSmsCommand}" Style="{StaticResource AtButton}"
                                ToolTip="命令 +CMGR= · 读取指定索引的短信（手册 5.8）"/>
                        <Button Content="删除短信" Command="{Binding DeleteSmsCommand}" Style="{StaticResource AtButton}"
                                ToolTip="命令 +CMGD= · 删除指定索引的短信，可附带删除标志（手册 5.6）"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <TextBlock Text="删除标志:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                            <ComboBox Style="{StaticResource AtCombo}" Width="180" SelectedValue="{Binding DeleteFlag}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="0 删单条" Tag="0"/>
                                <ComboBoxItem Content="1 删已读" Tag="1"/>
                                <ComboBoxItem Content="2 删已读+已发" Tag="2"/>
                                <ComboBoxItem Content="3 删已读+已发+未发" Tag="3"/>
                                <ComboBoxItem Content="4 删全部" Tag="4"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <TextBlock Text="列表状态:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                            <ComboBox ItemsSource="{Binding TextStats}" SelectedItem="{Binding TextStat}" Style="{StaticResource AtCombo}" Width="130"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <TextBlock Text="PDU stat:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                            <ComboBox Style="{StaticResource AtCombo}" Width="70" SelectedValue="{Binding PduStat}">
                                <ComboBoxItem Content="0"/>
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                            </ComboBox>
                        </StackPanel>
                        <Button Content="短信列表" Command="{Binding ListSmsCommand}" Style="{StaticResource AtButton}"
                                ToolTip="命令 +CMGL= · 按状态列出短信（手册 5.7）"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="新短信通知 +CNMI / 确认 +CNMA" Style="{StaticResource AtGroupBox}">
                <StackPanel>
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <TextBlock Text="mode:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                            <ComboBox Style="{StaticResource AtCombo}" Width="70" SelectedValue="{Binding CnmiMode}">
                                <ComboBoxItem Content="0"/><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <TextBlock Text="mt:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                            <ComboBox Style="{StaticResource AtCombo}" Width="70" SelectedValue="{Binding CnmiMt}">
                                <ComboBoxItem Content="0"/><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <TextBlock Text="bm:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                            <ComboBox Style="{StaticResource AtCombo}" Width="70" SelectedValue="{Binding CnmiBm}">
                                <ComboBoxItem Content="0"/><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <TextBlock Text="ds:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                            <ComboBox Style="{StaticResource AtCombo}" Width="70" SelectedValue="{Binding CnmiDs}">
                                <ComboBoxItem Content="0"/><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="bfr:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                            <ComboBox Style="{StaticResource AtCombo}" Width="70" SelectedValue="{Binding CnmiBfr}">
                                <ComboBoxItem Content="0"/><ComboBoxItem Content="1"/>
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="设置新短信通知" Command="{Binding SetCnmiCommand}" Style="{StaticResource AtButton}"
                                ToolTip="命令 +CNMI= · 设置新短信通知方式（手册 5.10）"/>
                        <Button Content="查询新短信通知" Command="{Binding QueryCnmiCommand}" Style="{StaticResource AtButton}"
                                ToolTip="命令 +CNMI? · 查询新短信通知方式（手册 5.10）"/>
                        <Button Content="确认新短信" Command="{Binding CnmaCommand}" Style="{StaticResource AtButton}"
                                ToolTip="命令 +CNMA · 确认收到新短信（手册 5.11）"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="短信服务 / 参数 / 其他" Style="{StaticResource AtGroupBox}">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="CSMS service:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                        <ComboBox Style="{StaticResource AtCombo}" Width="70" SelectedValue="{Binding CsmsService}">
                            <ComboBoxItem Content="0"/><ComboBoxItem Content="1"/>
                        </ComboBox>
                        <Button Content="设置短信服务" Command="{Binding SetCsmsCommand}" Style="{StaticResource AtButton}"
                                ToolTip="命令 +CSMS= · 选择短信服务类型（手册 5.3）"/>
                        <Button Content="查询短信服务" Command="{Binding QueryCsmsCommand}" Style="{StaticResource AtButton}"
                                ToolTip="命令 +CSMS? · 查询短信服务类型（手册 5.3）"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock Text="CSMP fo/vp/pid/dcs:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                        <TextBox Text="{Binding CsmpFo}" Style="{StaticResource AtInput}" Width="55"/>
                        <TextBox Text="{Binding CsmpVp}" Style="{StaticResource AtInput}" Width="55"/>
                        <TextBox Text="{Binding CsmpPid}" Style="{StaticResource AtInput}" Width="45"/>
                        <TextBox Text="{Binding CsmpDcs}" Style="{StaticResource AtInput}" Width="45"/>
                        <Button Content="设置短信参数" Command="{Binding SetCsmpCommand}" Style="{StaticResource AtButton}"
                                ToolTip="命令 +CSMP= · 设置 TEXT 模式短信参数（手册 5.16）"/>
                        <Button Content="查询短信参数" Command="{Binding QueryCsmpCommand}" Style="{StaticResource AtButton}"
                                ToolTip="命令 +CSMP? · 查询 TEXT 模式短信参数（手册 5.16）"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock Text="CSDH:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                        <ComboBox Style="{StaticResource AtCombo}" Width="70" SelectedValue="{Binding CsdhShow}">
                            <ComboBoxItem Content="0"/><ComboBoxItem Content="1"/>
                        </ComboBox>
                        <Button Content="设置短信头" Command="{Binding SetCsdhCommand}" Style="{StaticResource AtButton}"
                                ToolTip="命令 +CSDH= · 设置 TEXT 模式是否显示短信头（手册 5.15）"/>
                        <Button Content="查询短信头" Command="{Binding QueryCsdhCommand}" Style="{StaticResource AtButton}"
                                ToolTip="命令 +CSDH? · 查询 TEXT 模式短信头显示设置（手册 5.15）"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock Text="CMMS:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                        <ComboBox Style="{StaticResource AtCombo}" Width="70" SelectedValue="{Binding CmmsMode}">
                            <ComboBoxItem Content="0"/><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/>
                        </ComboBox>
                        <Button Content="设置更多提示" Command="{Binding SetCmmsCommand}" Style="{StaticResource AtButton}"
                                ToolTip="命令 +CMMS= · 设置更多短消息发送提示（手册 5.12）"/>
                        <Button Content="查询更多提示" Command="{Binding QueryCmmsCommand}" Style="{StaticResource AtButton}"
                                ToolTip="命令 +CMMS? · 查询更多短消息发送提示设置（手册 5.12）"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="小区广播 +CSCB" Style="{StaticResource AtGroupBox}">
                <StackPanel>
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <TextBlock Text="mode:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                            <ComboBox Style="{StaticResource AtCombo}" Width="70" SelectedValue="{Binding CscbMode}">
                                <ComboBoxItem Content="0"/><ComboBoxItem Content="1"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <TextBlock Text="mids:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                            <TextBox Text="{Binding CscbMids}" Style="{StaticResource AtInput}" Width="150"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="dcss:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                            <TextBox Text="{Binding CscbDcss}" Style="{StaticResource AtInput}" Width="150"/>
                        </StackPanel>
                    </WrapPanel>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="设置小区广播" Command="{Binding SetCscbCommand}" Style="{StaticResource AtButton}"
                                ToolTip="命令 +CSCB= · 选择小区广播类型（手册 5.14）"/>
                        <Button Content="查询小区广播" Command="{Binding QueryCscbCommand}" Style="{StaticResource AtButton}"
                                ToolTip="命令 +CSCB? · 查询小区广播类型（手册 5.14）"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
