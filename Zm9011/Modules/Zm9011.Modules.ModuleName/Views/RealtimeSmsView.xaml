<UserControl x:Class="Zm9011.Modules.ModuleName.Views.RealtimeSmsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 顶部图标按钮 -->
        <Style x:Key="SmsIconButton" TargetType="Button" BasedOn="{StaticResource AtGhostButton}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- 顶部更多按钮（ToggleButton） -->
        <Style x:Key="SmsIconToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F1F4"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EDEFF3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 会话列表项 -->
        <Style x:Key="SmsListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="6,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F2F4F7"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 消息列表项：不需要选中高亮 -->
        <Style x:Key="SmsMessageItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 链接式按钮：查看原文 / 收起原文 -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.75"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 绿色“复制密码”按钮 -->
        <Style x:Key="GreenActionButton" TargetType="Button">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15803D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#166534"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 底部发送按钮（纸飞机） -->
        <Style x:Key="SmsSendButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#22C55E"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="20">
                            <ContentPresenter x:Name="Icon" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#16A34A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15803D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#E6E8EE"/>
                                <Setter TargetName="Icon" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 弹出菜单项 -->
        <Style x:Key="MenuButton" TargetType="Button" BasedOn="{StaticResource AtGhostButton}">
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= 左侧：收件箱 ================= -->
        <Border Grid.Column="0" Background="#FBFCFE"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="16,14" BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,0,0,1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="收件箱" FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource Brush.TextPrimary}"/>
                            <Border Background="{StaticResource Brush.AccentSoft}" CornerRadius="8"
                                    Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Conversations.Count}" FontSize="11"
                                           Foreground="{StaticResource Brush.Accent}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#C2C5CC"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Service.IsRealtimeEnabled}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Brush.Success}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding Service.StatusText}" FontSize="11"
                                       Foreground="{StaticResource Brush.TextMuted}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <ListBox ItemsSource="{Binding Conversations}"
                             SelectedItem="{Binding SelectedConversation}"
                             IsSynchronizedWithCurrentItem="False"
                             Background="Transparent" BorderThickness="0" Padding="0,6"
                             ItemContainerStyle="{StaticResource SmsListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 绿色对话图标 -->
                                    <Border Width="40" Height="40" CornerRadius="10"
                                            Background="#16A34A" VerticalAlignment="Center">
                                        <Viewbox Width="22" Height="22">
                                            <Path Data="M4,3 H20 A3,3 0 0 1 23,6 V14 A3,3 0 0 1 20,17 H11 L6,22 V17 H4 A3,3 0 0 1 1,14 V6 A3,3 0 0 1 4,3 Z"
                                                  Fill="White"/>
                                        </Viewbox>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Sender}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Preview}" FontSize="11.5"
                                                   Foreground="{StaticResource Brush.TextMuted}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding TimeText}" FontSize="10.5"
                                                   Foreground="#A6A9B0" HorizontalAlignment="Right"/>
                                        <Border Background="{StaticResource Brush.Accent}" CornerRadius="8"
                                                Padding="6,0" Margin="0,4,0,0" HorizontalAlignment="Right">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding UnreadText}" Foreground="White"
                                                       FontSize="10" Margin="0,1"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 收件箱空状态 -->
                    <TextBlock Text="暂无短信，收到新短信后自动加载"
                               Foreground="#C2C5CC" FontSize="11.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="220">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Conversations.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- ================= 右侧：会话详情 ================= -->
        <Grid Grid.Column="1" Background="#F7F8FA">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 会话头部：返回 / 号码 / 电话与更多 -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,0,1" Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="←" Command="{Binding BackCommand}"
                            Style="{StaticResource SmsIconButton}" ToolTip="返回会话列表"/>

                    <TextBlock Grid.Column="1" Text="{Binding SelectedSender}" FontSize="15"
                               FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="☎" Command="{Binding CopyNumberCommand}"
                                Style="{StaticResource SmsIconButton}"
                                ToolTip="复制发送者号码（本工具不支持拨号）"/>
                        <ToggleButton x:Name="MoreToggle" Content="⋮" Style="{StaticResource SmsIconToggle}"
                                      ToolTip="更多操作"/>
                        <Popup IsOpen="{Binding IsChecked, ElementName=MoreToggle}" Placement="Bottom"
                               PlacementTarget="{Binding ElementName=MoreToggle}" StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Background="White" BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1" CornerRadius="10" Padding="6" Margin="0,4,0,0"
                                    MinWidth="164">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270"
                                                      Opacity="0.12" Color="#1A1A1A"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Button Content="复制号码" Command="{Binding CopyNumberCommand}"
                                            Style="{StaticResource MenuButton}"/>
                                    <Button Content="清空本会话" Command="{Binding ClearConversationCommand}"
                                            Style="{StaticResource MenuButton}"/>
                                    <Button Content="导出全部短信" Command="{Binding ExportCommand}"
                                            Style="{StaticResource MenuButton}"/>
                                    <Button Content="打开存储目录" Command="{Binding OpenStorageFolderCommand}"
                                            Style="{StaticResource MenuButton}"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 消息时间线 -->
            <Grid Grid.Row="1">
                <ListBox x:Name="MessageList" ItemsSource="{Binding SelectedConversation.Messages}"
                         IsSynchronizedWithCurrentItem="False"
                         Background="Transparent" BorderThickness="0" Padding="24,12"
                         ItemContainerStyle="{StaticResource SmsMessageItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding TimeText}" HorizontalAlignment="Center"
                                           FontSize="10" Foreground="#A6A9B0" Margin="0,0,0,3"/>

                                <Border x:Name="Card" MaxWidth="560" HorizontalAlignment="Left"
                                        Background="White" BorderBrush="{StaticResource Brush.Border}"
                                        BorderThickness="1" CornerRadius="14" Padding="10,8"
                                        Margin="0,0,0,6">
                                    <StackPanel>
                                        <!-- 验证消息头部 -->
                                        <StackPanel x:Name="VerifyHeader" Orientation="Horizontal"
                                                    Visibility="Collapsed">
                                            <Border Width="36" Height="36" CornerRadius="10" Background="#16A34A">
                                                <Viewbox Width="22" Height="22">
                                                    <Path Data="M4,3 H20 A3,3 0 0 1 23,6 V14 A3,3 0 0 1 20,17 H11 L6,22 V17 H4 A3,3 0 0 1 1,14 V6 A3,3 0 0 1 4,3 Z"
                                                          Fill="White"/>
                                                </Viewbox>
                                            </Border>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="验证消息" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#111827"/>
                                                <Border Background="#E9F9F1" CornerRadius="4" Padding="6,1"
                                                        HorizontalAlignment="Left" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding Tag}" FontSize="10.5"
                                                               Foreground="#0E9F6E"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 普通短信头部 -->
                                        <StackPanel x:Name="NormalHeader" Orientation="Horizontal"
                                                    Visibility="Collapsed">
                                            <Border Width="36" Height="36" CornerRadius="10" Background="#EFF2F7">
                                                <Viewbox Width="20" Height="20">
                                                    <Path Data="M4,3 H20 A3,3 0 0 1 23,6 V14 A3,3 0 0 1 20,17 H11 L6,22 V17 H4 A3,3 0 0 1 1,14 V6 A3,3 0 0 1 4,3 Z"
                                                          Fill="#6B7078"/>
                                                </Viewbox>
                                            </Border>
                                            <TextBlock Text="短信" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#111827" Margin="10,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- 验证码大字 -->
                                        <TextBlock x:Name="CodeText" Text="{Binding VerificationCode}"
                                                   FontSize="28" FontWeight="Bold" Foreground="#111827"
                                                   Margin="0,6,0,0" Visibility="Collapsed"/>

                                        <!-- 正文 -->
                                        <TextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="13"
                                                   Foreground="#374151" LineHeight="20" Margin="0,6,0,0"/>

                                        <!-- 复制密码 -->
                                        <Button x:Name="CopyCodeButton" Content="复制密码"
                                                Command="{Binding DataContext.CopyCodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding VerificationCode}"
                                                Style="{StaticResource GreenActionButton}"
                                                HorizontalAlignment="Left" Margin="0,8,0,0"
                                                Visibility="Collapsed"/>

                                        <!-- 查看原文 -->
                                        <Button x:Name="RawToggle" HorizontalAlignment="Left" Margin="0,6,0,0"
                                                Command="{Binding DataContext.ToggleRawCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="{Binding RawLinkText}"/>
                                        </Button>
                                        <TextBlock Text="{Binding RawText}"
                                                   Visibility="{Binding IsRawVisible, Converter={StaticResource BoolToVis}}"
                                                   TextWrapping="Wrap" FontFamily="Consolas"
                                                   FontSize="10.5" Foreground="#9CA1AA" Margin="0,5,0,0"/>

                                        <!-- 验证码保护提示 -->
                                        <StackPanel x:Name="ShieldHint" Orientation="Horizontal"
                                                    Visibility="{Binding IsVerification, Converter={StaticResource BoolToVis}}"
                                                    Margin="0,6,0,0">
                                            <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                                <Grid Width="24" Height="24">
                                                    <Path Data="M12,1 L22,4.5 V11 C22,16.5 17.8,21 12,23 C6.2,21 2,16.5 2,11 V4.5 Z"
                                                          Fill="#4D6BFE"/>
                                                    <Path Data="M7,12 L10.5,15.5 L17,8.5" Stroke="White"
                                                          StrokeThickness="2.2" StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" Fill="Transparent"/>
                                                </Grid>
                                            </Viewbox>
                                            <TextBlock Text="已开启验证码保护，禁止第三方应用读取"
                                                       FontSize="10.5" Foreground="#4D6BFE"
                                                       Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsVerification}" Value="True">
                                    <Setter TargetName="VerifyHeader" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="CodeText" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="CopyCodeButton" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsVerification}" Value="False">
                                    <Setter TargetName="NormalHeader" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                    <Setter TargetName="Card" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="Card" Property="Background" Value="#DCFCE7"/>
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#BBF7D0"/>
                                    <Setter TargetName="Card" Property="MaxWidth" Value="520"/>
                                    <Setter TargetName="VerifyHeader" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="NormalHeader" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="CodeText" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="CopyCodeButton" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 未选择会话时的提示 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedConversation}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Width="56" Height="56" CornerRadius="16" Background="#EFF2F7"
                            HorizontalAlignment="Center">
                        <Viewbox Width="30" Height="30">
                            <Path Data="M4,3 H20 A3,3 0 0 1 23,6 V14 A3,3 0 0 1 20,17 H11 L6,22 V17 H4 A3,3 0 0 1 1,14 V6 A3,3 0 0 1 4,3 Z"
                                  Fill="#C2C5CC"/>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="选择左侧会话查看短信" FontSize="12" Foreground="#B4B7BE"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 底部回复栏：加号 / 输入框 / SIM 徽标 / 发送 -->
            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,1,0,0" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="+" Command="{Binding InsertCodeCommand}"
                            Style="{StaticResource SmsIconButton}" FontSize="20" Width="38" Height="38"
                            ToolTip="把当前会话最近的验证码填入输入框"/>

                    <Grid Grid.Column="1" Margin="8,0">
                        <TextBox Text="{Binding ReplyText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0" MinHeight="38" FontSize="13"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Text="短信" IsHitTestVisible="False" Foreground="#B4B7BE"
                                   FontSize="13" Margin="13,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ReplyText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- 当前 SIM 卡槽徽标 -->
                    <Border Grid.Column="2" Background="{StaticResource Brush.Accent}" CornerRadius="9"
                            Padding="7,2" Margin="0,0,10,0" VerticalAlignment="Center"
                            ToolTip="当前 SIM 卡槽（启用实时接收时查询 +ZSWSLOT?）">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Service.HasSimSlot}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Service.SimSlotText}" Foreground="White" FontSize="11"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <Button Grid.Column="3" Command="{Binding SendReplyCommand}"
                            Style="{StaticResource SmsSendButton}"
                            ToolTip="发送短信（中文自动使用 UCS2 编码）">
                        <Path Data="M2,21 L23,12 L2,3 L2,10 L17,12 L2,14 Z" Fill="White"
                              Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>
