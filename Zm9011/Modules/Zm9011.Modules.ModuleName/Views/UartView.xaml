<UserControl x:Class="Zm9011.Modules.ModuleName.Views.UartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1180" HorizontalAlignment="Stretch">

            <GroupBox Header="串口参数 +UARTPARA（设置后模组串口立即切换，PC 侧需同步改波特率重连）" Style="{StaticResource AtGroupBox}">
                <StackPanel>
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock Text="波特率:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                            <ComboBox ItemsSource="{Binding BaudRateOptions}" SelectedItem="{Binding BaudRate}"
                                      Style="{StaticResource AtCombo}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock Text="校验位:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                            <TextBox Text="{Binding Parity}" Style="{StaticResource AtInput}" Width="55" IsEnabled="False"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock Text="数据位:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                            <TextBox Text="{Binding DataBits}" Style="{StaticResource AtInput}" Width="55" IsEnabled="False"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock Text="停止位:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                            <TextBox Text="{Binding StopBits}" Style="{StaticResource AtInput}" Width="55" IsEnabled="False"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="流控:" Style="{StaticResource AtFieldLabel}" Margin="3,0,6,0"/>
                            <TextBox Text="{Binding FlowControl}" Style="{StaticResource AtInput}" Width="55" IsEnabled="False"/>
                        </StackPanel>
                    </WrapPanel>
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock Text="(ZM9011 固定 0,8,1,0)" Foreground="#9CA1AA" VerticalAlignment="Center" Margin="3,0,10,0"/>
                        <Button Content="设置串口参数" Command="{Binding SetUartParaCommand}" Style="{StaticResource AtButton}"
                                ToolTip="命令 +UARTPARA= · 设置 UART 串口参数：baud,parity,data bits,stop bits,flow control（手册 9.1）"/>
                        <Button Content="查询串口参数" Command="{Binding QueryUartParaCommand}" Style="{StaticResource AtButton}"
                                ToolTip="命令 +UARTPARA? · 查询当前 UART 串口参数（手册 9.1）"/>
                        <Button Content="测试参数范围" Command="{Binding TestUartParaCommand}" Style="{StaticResource AtButton}"
                                ToolTip="命令 +UARTPARA=? · 查询命令支持的参数取值范围（手册 9.1）"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="波特率自适应开关 +UARTSELFADAPTION" Style="{StaticResource AtGroupBox}">
                <WrapPanel>
                    <ComboBox Style="{StaticResource AtCombo}" Width="110" SelectedValue="{Binding AdaptionFlag}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="1 开启" Tag="1"/>
                        <ComboBoxItem Content="0 关闭" Tag="0"/>
                    </ComboBox>
                    <Button Content="设置自适应" Command="{Binding SetAdaptionCommand}" Style="{StaticResource AtButton}"
                            ToolTip="命令 +UARTSELFADAPTION= · 设置 UART 波特率自适应开关（手册 10.2）"/>
                    <Button Content="查询自适应" Command="{Binding QueryAdaptionCommand}" Style="{StaticResource AtButton}"
                            ToolTip="命令 +UARTSELFADAPTION? · 查询 UART 波特率自适应开关（手册 10.2）"/>
                    <TextBlock Text="(模组默认开启自适应)" Foreground="#9CA1AA" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </WrapPanel>
            </GroupBox>

            <GroupBox Header="波特率探测（PC 侧按当前串口配置发 AT 试探）" Style="{StaticResource AtGroupBox}">
                <WrapPanel>
                    <Button Content="开始探测" Command="{Binding ProbeCommand}" Style="{StaticResource AtButton}"
                            ToolTip="命令 AT · 逐档波特率发送 AT 探测模组响应（手册 10.1）"/>
                    <TextBlock Text="{Binding ProbeResult}" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="#C2650A" FontWeight="SemiBold"/>
                </WrapPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
