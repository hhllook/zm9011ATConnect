#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/zm9011d
CONFIG=/etc/config/zm9011
DATA_DIR=/etc/zm9011

start_service() {
	mkdir -p "$DATA_DIR"

	procd_open_instance
	procd_set_param command "$PROG" -config "$CONFIG"
	# 异常退出后自动拉起：threshold=3600s，timeout=5s，retry=5
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	:
}

service_triggers() {
	procd_add_reload_trigger zm9011
}

reload_service() {
	stop
	start
}
