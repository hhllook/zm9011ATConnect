config zm9011 'main'
	# 串口设备：auto 表示自动探测；也可以固定为 /dev/ttyUSB2
	option device 'auto'
	# AT 口波特率
	option baud '115200'
	# HTTP 监听地址（内网使用，建议保持 0.0.0.0 只开放 LAN）
	option listen '0.0.0.0'
	# HTTP 端口
	option port '8080'
	# 非空时启用 HTTP Basic Auth（用户名任意，密码使用此值）
	option password ''
	# 读取短信成功后删除模组内短信，避免模组存储占满
	option delete_after_read '1'
	# 本地短信数据目录（持久化）
	option data_dir '/etc/zm9011'
